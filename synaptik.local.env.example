# Copy to synaptik.local.env (gitignored) — variant A: shared keys, separate product workspace.
# Use from ANY repo: place synaptik.local.env in your product root, then run from AICADS-PRO:
#   npm run synaptik:ui -- --workspace C:/path/to/your-product
#
# Or set these in PowerShell before npm run dev in modules/synaptik-icon-builder/ui

# Shared secrets (one file, never commit)
SYNAPTIK_ENV_FILE=C:/Users/user/Desktop/Project/AICADS-publish/.env

# Product repo: synaptik.config.json, .synaptik/sessions, generated-icons outputDir
SYNAPTIK_WORKSPACE_ROOT=C:/path/to/your-product-repo
